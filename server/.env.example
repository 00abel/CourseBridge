DATABASE_URL="file:./dev.db"

# use at least 32 random characters
JWT_SECRET=""

# use 64 hex characters and keep this key when redeploying
TOKEN_ENCRYPTION_KEY=""

FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV="development"

# school hostnames separated by commas with no https or paths
CANVAS_ALLOWED_HOSTS=""

# only set this to the ip addresses or subnets of a trusted reverse proxy
TRUST_PROXY=""
