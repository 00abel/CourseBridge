# Copy this file to .env and fill in the values.
# Never commit .env to git. It contains secrets.

# Path to your SQLite database file
DATABASE_URL="file:./dev.db"

# Secret key for signing login tokens. Change this to something random.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Key used to encrypt Canvas and Notion tokens in the database. 64 hex characters.
# Generate one with the same command as above. Use a DIFFERENT value than JWT_SECRET.
# If you lose or change this, saved tokens can't be read and users must reconnect.
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters"

# The URL of your frontend (for CORS, and where Canvas OAuth sends users back to)
FRONTEND_URL="http://localhost:5173"

# Set to "production" when deploying
NODE_ENV="development"

# ── Canvas OAuth ("Connect with Canvas") ──────────────────────────────────
# Leave these blank until a Canvas admin creates a Developer Key for this app.
# While blank, the app works exactly as before with personal tokens.

# From the Developer Key the Canvas admin creates
CANVAS_CLIENT_ID=""
CANVAS_CLIENT_SECRET=""

# The Canvas instance the key belongs to, e.g. https://canvas.uw.edu
CANVAS_OAUTH_BASE_URL=""

# Must exactly match the Redirect URI saved on the Developer Key.
# Local:      http://localhost:3001/api/canvas/oauth/callback
# Production: https://YOUR-RAILWAY-URL/api/canvas/oauth/callback
CANVAS_REDIRECT_URI=""

# Optional. Only needed if the admin turns on scope enforcement for the key.
# CANVAS_SCOPES="url:GET|/api/v1/courses url:GET|/api/v1/courses/:course_id/assignments"
CANVAS_SCOPES=""
