// This is your database schema.
// Prisma reads this file and generates the DB tables for you.
// Run `npm run db:push` to apply changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Uses SQLite locally. To switch to Postgres (e.g. Railway),
  // change "sqlite" to "postgresql" and update DATABASE_URL in .env
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One row per user account
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  // Each user has their own config, sync maps, and logs
  config   Config?
  syncMaps SyncMap[]
  syncLogs SyncLog[]
}

// Stores Canvas + Notion credentials per user.
// Tokens are encrypted before saving (see services/crypto.js).
// Fields are optional so a user can connect Canvas and Notion in separate steps.
model Config {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // How Canvas is connected: "token" (pasted personal token) or "oauth" (Connect with Canvas)
  canvasAuthType       String?
  canvasBaseUrl        String?    // e.g. https://canvas.school.edu
  canvasToken          String?    // personal token, or OAuth access token (expires after 1 hour)
  canvasRefreshToken   String?    // OAuth only: used to get a new access token without logging in again
  canvasTokenExpiresAt DateTime?  // OAuth only: when the current access token stops working
  canvasUserName       String?    // OAuth only: display name Canvas returns, shown in the UI

  notionToken   String?  // Notion integration token
  notionDbId    String?  // ID of the target Notion database
}

// Maps a Canvas assignment ID → Notion page ID
// This is how we avoid creating duplicates on re-sync
model SyncMap {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  canvasId     String   // Canvas assignment ID (e.g. "12345")
  notionPageId String   // Notion page ID we created/updated
  courseId     String   // Canvas course ID
  lastSynced   DateTime @updatedAt

  @@unique([userId, canvasId]) // One mapping per user per assignment
}

// A log entry for each sync run
model SyncLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  syncedAt DateTime @default(now())
  created  Int      // How many new Notion pages were created
  updated  Int      // How many existing pages were updated
  failed   Int      // How many assignments failed to sync
  errors   String?  // JSON string with error details (if any)
}
